# SHIP node — runs INSIDE the container. DATABASE_URL is set by the entrypoint to the
# container's OWN Postgres; never point this at the host DB.
SYNC_INSTANCE_ID=SHIP-WKFV             # MUST equal 'SHIP-' + vessels.id (NOT vuuid)
SYNC_SHORE_URL=http://shore.pilot:5000/technical/api   # MUST include /technical/api
APP_ENV=local
NODE_ENV=development
EXTERNAL_MASTER_DATA_URL_DEV=http://localhost:9999
LOCAL_PILOT_DOMAIN=Wah Kwong
