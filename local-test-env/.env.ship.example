# SHIP node — runs INSIDE the container. DATABASE_URL is set by the entrypoint to the
# container's OWN Postgres; never point this at the host DB.
#
# ⚠️ NO INLINE COMMENTS IN THIS FILE. `docker run --env-file` does NOT strip a trailing
# `# ...` — it keeps the whole rest of the line as the value. The inline comment that used to
# sit on the SYNC_INSTANCE_ID line below made the ship's identity literally
# "SHIP-WKFV             # MUST equal 'SHIP-' + vessels.id (NOT vuuid)", which is trap #2 in
# the runbook caused by the very comment warning about it. Comments go on their own line.

# MUST equal 'SHIP-' + vessels.id (NOT vuuid)
SYNC_INSTANCE_ID=SHIP-WKFV

# MUST include /technical/api — without it the ship hits the SPA catch-all and sync dies with
# "Unexpected token '<', "<!DOCTYPE "... is not valid JSON"
SYNC_SHORE_URL=http://shore.pilot:5000/technical/api

APP_ENV=local
NODE_ENV=development
EXTERNAL_MASTER_DATA_URL_DEV=http://localhost:9999
LOCAL_PILOT_DOMAIN=Wah Kwong

# Phase 0 / P0.1 — 0 = real forwarded role; 1 = old everyone-is-Sail-Admin mock (standalone UI only)
PMS_AUTH_MOCK_RBAC=0
