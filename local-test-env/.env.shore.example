# SHORE node — runs on the HOST. Copy to a local file and source it, or pass inline.
# Shore is the authoritative side and the sync responder; it never initiates sync.
DATABASE_URL=postgres://postgres:admin123@localhost:5432/pms_arch
SYNC_INSTANCE_ID=SHORE-PILOT          # anything NOT starting with SHIP- is treated as shore
APP_ENV=local                         # gates the WK-domain shim (see LOCAL_PILOT_DOMAIN)
NODE_ENV=development
PORT=5000
EXTERNAL_MASTER_DATA_URL_DEV=http://localhost:9999   # mandatory; dummy is fine, no SAILERP locally
# QUOTES ARE LOAD-BEARING: up.sh does `set -a; . this-file`, so an unquoted value
# containing a space is parsed as VAR=Wah then the command `Kwong` — which fails,
# and `set -e` aborts the whole script before the shore ever starts. (Sibling trap
# to the ship template's inline-comment bug fixed in 049e67db1; that fix's message
# wrongly declared this file unaffected — different mechanism, same file class.)
LOCAL_PILOT_DOMAIN="Wah Kwong"         # local-only domain shim; inert unless APP_ENV=local
