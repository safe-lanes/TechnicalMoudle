# ==============================================
# Server Configuration
# ==============================================
NODE_ENV=development
PORT=5002

# ==============================================
# Database Configuration
# ==============================================
DATABASE_URL=

# ==============================================
# Ship-Shore Sync Configuration
# ==============================================
SYNC_INSTANCE_ID=

# ==============================================
# External Master Data APIs
# ==============================================
# Proxy server URL (used for most master data endpoints via /technical/api/external/master-data/:endpoint)
EXTERNAL_MASTER_DATA_URL_DEV=
EXTERNAL_MASTER_DATA_URL_PROD=
APP_ENV=dev

# ==============================================
# Shipskart SSO Integration (Purchasing module)
# Backend-only. NEVER expose these on the frontend, never commit real values.
# Base URL uses /identity-management (NOT /user-management).
# ==============================================
SHIPSKART_SSO_BASE_URL=
SHIPSKART_API_KEY=
SHIPSKART_HMAC_SECRET=
SHIPSKART_TENANT_ID=
# Role-based externalUserId mapping. Same role → same Shipskart account.
SHIPSKART_USER_VESSEL_ADMIN=
SHIPSKART_USER_ADMIN=
SHIPSKART_USER_REGULAR=
