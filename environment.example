# Element Crew Appraisals System - Environment Variables Template

# Database Configuration (Primary - MySQL)
DATABASE_URL="mysql://username:password@host:port/database_name"

# Alternative MySQL Configuration (if DATABASE_URL not used)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="your_username"
MYSQL_PASSWORD="your_password"
MYSQL_DATABASE="crew_appraisals"

# Server Configuration
NODE_ENV="development"
PORT="5000"

# Session Configuration
SESSION_SECRET="your-super-secret-session-key-here"

# ─── Environment Detection ───────────────────────────────────────────
# APP_ENV controls which external API URL the system uses.
# Valid values: local | dev | production
#
# If APP_ENV is NOT set, it is inferred from NODE_ENV:
#   NODE_ENV=development → APP_ENV=local
#   NODE_ENV=production  → APP_ENV=production
#
# It is strongly recommended to set APP_ENV explicitly.
APP_ENV="dev"

# ─── External Master Data API ────────────────────────────────────────
# Two separate URLs are required — one for dev and one for production.
# The system selects which one to use based on APP_ENV:
#   APP_ENV=local      → uses EXTERNAL_MASTER_DATA_URL_DEV
#   APP_ENV=dev        → uses EXTERNAL_MASTER_DATA_URL_DEV
#   APP_ENV=production → uses EXTERNAL_MASTER_DATA_URL_PROD
#
# Both must be set. The server will NOT start if the required URL is missing.
EXTERNAL_MASTER_DATA_URL_DEV="https://dev.sl-sail.com/b/api/v1/crewmasterdata/getallmasterdata"
EXTERNAL_MASTER_DATA_URL_PROD="https://prod.sl-sail.com/b/api/v1/crewmasterdata/getallmasterdata"

# ─── Sample .env files per environment ───────────────────────────────
#
# .env.local (developer machine):
#   APP_ENV=local
#   EXTERNAL_MASTER_DATA_URL_DEV=https://dev.sl-sail.com/b/api/v1/crewmasterdata/getallmasterdata
#   EXTERNAL_MASTER_DATA_URL_PROD=  (not needed, but set to avoid errors if APP_ENV changes)
#
# .env.development (dev server, e.g. dev.sl-sail.com):
#   APP_ENV=dev
#   EXTERNAL_MASTER_DATA_URL_DEV=https://dev.sl-sail.com/b/api/v1/crewmasterdata/getallmasterdata
#   EXTERNAL_MASTER_DATA_URL_PROD=  (not needed)
#
# .env.production (production server):
#   APP_ENV=production
#   EXTERNAL_MASTER_DATA_URL_PROD=https://prod.sl-sail.com/b/api/v1/crewmasterdata/getallmasterdata
#   EXTERNAL_MASTER_DATA_URL_DEV=  (not needed)

# Optional: External API Keys (if needed for future features)
# STRIPE_SECRET_KEY="sk_test_..."
# SENDGRID_API_KEY="SG...."
# TWILIO_ACCOUNT_SID="AC...."
# TWILIO_AUTH_TOKEN="your-auth-token"

# Development Settings (only needed for development)
# VITE_API_BASE_URL="http://localhost:5000"
# LOG_LEVEL="debug"

# Production Settings
# CORS_ORIGIN="https://your-domain.com"
# SECURE_COOKIES="true"
# TRUST_PROXY="true"
